{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug Swift (CodeLLDB)",
            "type": "lldb",
            "request": "launch",
            "program": "${workspaceFolder}/.build/debug/Swift-Repo",
            "cwd": "${workspaceFolder}",
            "args": [],
            "preLaunchTask": "swift: Build Debug Swift-Repo",
            "env": {
                "SWIFT_BACKTRACE": "enable"
            }
        },
        {
            "type": "swift",
            "request": "launch",
            "args": [],
            "cwd": "${workspaceFolder:Swift-Repo}",
            "name": "Debug Swift-Repo",
            "preLaunchTask": "swift: Build Debug Swift-Repo",
            "target": "Swift-Repo",
            "configuration": "debug"
        },
        {
            "type": "swift",
            "request": "launch",
            "args": [],
            "cwd": "${workspaceFolder:Swift-Repo}",
            "name": "Release Swift-Repo",
            "preLaunchTask": "swift: Build Release Swift-Repo",
            "target": "Swift-Repo",
            "configuration": "release"
        }
    ]
}